+	private static int GetLodLevel(string name)
+	{
+		int marker = name.LastIndexOf("_LOD", StringComparison.OrdinalIgnoreCase);
+		if (marker >= 0 && marker + 4 < name.Length && name[marker + 4] is >= '0' and <= '9')
+		{
+			return name[marker + 4] - '0';
+		}
+
+		return 0;
+	}
