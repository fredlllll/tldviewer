+	private static bool ShouldSkipForVisualization(string name, bool includeAllLods)
+	{
+		if (name.Contains("shadow", StringComparison.OrdinalIgnoreCase)
+			|| name.Contains("shadow_caster", StringComparison.OrdinalIgnoreCase)
+			|| name.Contains("impostor", StringComparison.OrdinalIgnoreCase)
+			|| name.Contains("collision", StringComparison.OrdinalIgnoreCase)
+			|| name.Contains("collider", StringComparison.OrdinalIgnoreCase)
+			|| name.Contains("navmesh", StringComparison.OrdinalIgnoreCase))
+		{
+			return true;
+		}
+
+		if (includeAllLods)
+		{
+			return false;
+		}
+
+		int marker = name.IndexOf("_LOD", StringComparison.OrdinalIgnoreCase);
+		if (marker < 0)
+		{
+			return false;
+		}
+
+		int digit = marker + 4;
+		return digit < name.Length && name[digit] >= '1' && name[digit] <= '9';
+	}
