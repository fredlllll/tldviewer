+			GlbMeshType.PositionNormal | GlbMeshType.Color1Texture1 | GlbMeshType.Empty => BuildSubMeshes<VertexPositionNormal, VertexTexture1, VertexEmpty>(parameters),
+			GlbMeshType.PositionNormalTangent | GlbMeshType.Color1Texture1 | GlbMeshType.Empty => BuildSubMeshes<VertexPositionNormalTangent, VertexTexture1, VertexEmpty>(parameters),
+			GlbMeshType.Position | GlbMeshType.Color1Texture2 | GlbMeshType.Empty => BuildSubMeshes<VertexPosition, VertexTexture2, VertexEmpty>(parameters),
+			GlbMeshType.PositionNormal | GlbMeshType.Color1Texture2 | GlbMeshType.Empty => BuildSubMeshes<VertexPositionNormal, VertexTexture2, VertexEmpty>(parameters),
+			GlbMeshType.PositionNormalTangent | GlbMeshType.Color1Texture2 | GlbMeshType.Empty => BuildSubMeshes<VertexPositionNormalTangent, VertexTexture2, VertexEmpty>(parameters),
+			GlbMeshType.Position | GlbMeshType.Color1TextureN | GlbMeshType.Empty => BuildSubMeshes<VertexPosition, VertexTexture1, VertexEmpty>(parameters),
+			GlbMeshType.PositionNormal | GlbMeshType.Color1TextureN | GlbMeshType.Empty => BuildSubMeshes<VertexPositionNormal, VertexTexture1, VertexEmpty>(parameters),
+			GlbMeshType.PositionNormalTangent | GlbMeshType.Color1TextureN | GlbMeshType.Empty => BuildSubMeshes<VertexPositionNormalTangent, VertexTexture1, VertexEmpty>(parameters),
+			GlbMeshType.Position | GlbMeshType.TextureN | GlbMeshType.Empty => BuildSubMeshes<VertexPosition, VertexTexture1, VertexEmpty>(parameters),
+			GlbMeshType.PositionNormal | GlbMeshType.TextureN | GlbMeshType.Empty => BuildSubMeshes<VertexPositionNormal, VertexTexture1, VertexEmpty>(parameters),
+			GlbMeshType.PositionNormalTangent | GlbMeshType.TextureN | GlbMeshType.Empty => BuildSubMeshes<VertexPositionNormalTangent, VertexTexture1, VertexEmpty>(parameters),
+			_ => BuildSubMeshesForMeshType(parameters),
