+			{
+				array[i] = (subMeshes[subsetIndices[i]], parameters.GetOrMakeMaterial(materialList[i]));
+			}
+
+			return GlbSubMeshBuilder.BuildSubMeshes(
+				new ArraySegment<(ISubMesh, MaterialBuilder)>(array, 0, subsetIndices.Length),
+				mesh.Is16BitIndices(),
+				meshData,
+				globalInverseTransform,
+				globalTransform);
+		}
+		finally
+		{
+			ArrayPool<(ISubMesh, MaterialBuilder)>.Shared.Return(array);
+		}
+	}
