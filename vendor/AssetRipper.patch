+	/// <summary>
+	/// Yields every visual mesh in the scene as an independent draw item with a
+	/// world-space transform. Materials are cached for the whole enumeration so
+	/// all draw items share the same <see cref="MaterialBuilder"/> instances.
+	/// </summary>
+	public static IEnumerable<GlbDrawMesh> BuildDrawMeshes(IEnumerable<IUnityObjectBase> assets, bool includeAllLods)
+	{
+		BuildParameters parameters = new(isScene: true);
+		HashSet<IUnityObjectBase> exportedAssets = new();
+
+		foreach (IUnityObjectBase asset in assets)
+		{
+			if (exportedAssets.Contains(asset) || asset is not (IGameObject or IComponent))
+			{
+				continue;
+			}
+
+			IGameObject root = GetRoot(asset);
+			foreach (GlbDrawMesh drawMesh in CollectDrawMeshes(
+				parameters,
+				root.GetTransform(),
+				Transformation.Identity,
+				Transformation.Identity,
+				Matrix4x4.Identity,
+				includeAllLods))
+			{
+				yield return drawMesh;
+			}
+
+			foreach (IEditorExtension exportedAsset in root.FetchHierarchy())
+			{
+				exportedAssets.Add(exportedAsset);
+			}
+		}
+	}
