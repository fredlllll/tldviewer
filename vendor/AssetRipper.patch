+	private static IEnumerable<GlbDrawMesh> CollectDrawMeshes(
+		BuildParameters parameters,
+		ITransform transform,
+		Transformation parentGlobalTransform,
+		Transformation parentGlobalInverseTransform,
+		Matrix4x4 parentGltfWorldMatrix,
+		bool includeAllLods)
+	{
+		IGameObject? gameObject = transform.GameObject_C4P;
+		if (gameObject is null || ShouldSkipForVisualization(gameObject.Name, includeAllLods))
+		{
+			yield break;
+		}
+
+		int lod = GetLodLevel(gameObject.Name);
+		if (!includeAllLods && lod > 0)
+		{
+			yield break;
+		}
+
+		Transformation localTransform = transform.ToTransformation();
+		Transformation localInverseTransform = transform.ToInverseTransformation();
+		Transformation globalTransform = localTransform * parentGlobalTransform;
+		Transformation globalInverseTransform = parentGlobalInverseTransform * localInverseTransform;
+
+		Matrix4x4 localGltfMatrix = Matrix4x4.CreateScale(transform.LocalScale_C4.X, transform.LocalScale_C4.Y, transform.LocalScale_C4.Z)
+			* Matrix4x4.CreateFromQuaternion(GlbCoordinateConversion.ToGltfQuaternionConvert(transform.LocalRotation_C4))
+			* Matrix4x4.CreateTranslation(GlbCoordinateConversion.ToGltfVector3Convert(transform.LocalPosition_C4));
+		Matrix4x4 gltfWorldMatrix = localGltfMatrix * parentGltfWorldMatrix;
+
+		if (gameObject.TryGetComponent(out IMeshFilter? meshFilter)
+			&& meshFilter.TryGetMesh(out IMesh? mesh)
+			&& mesh.IsSet()
+			&& parameters.TryGetOrMakeMeshData(mesh, out MeshData meshData)
+			&& gameObject.TryGetComponent(out IRenderer? renderer))
+		{
+			bool dynamic = ReferencesDynamicMesh(renderer);
+			IMeshBuilder<MaterialBuilder>? meshBuilder = BuildMeshBuilder(
+				parameters,
+				mesh,
+				meshData,
+				renderer,
+				dynamic,
+				globalTransform,
+				globalInverseTransform);
+			if (meshBuilder is not null)
+			{
+				yield return new GlbDrawMesh(gameObject.Name, meshBuilder, gltfWorldMatrix, lod);
+			}
+		}
+
+		foreach (ITransform childTransform in transform.Children_C4P.WhereNotNull())
+		{
+			foreach (GlbDrawMesh child in CollectDrawMeshes(
+				parameters,
+				childTransform,
+				localTransform * parentGlobalTransform,
+				parentGlobalInverseTransform * localInverseTransform,
+				gltfWorldMatrix,
+				includeAllLods))
+			{
+				yield return child;
+			}
+		}
+	}
